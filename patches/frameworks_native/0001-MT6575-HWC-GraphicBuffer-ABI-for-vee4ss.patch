@@ -95,6 +107,9 @@ GraphicBuffer::GraphicBuffer(ANativeWindowBuffer* buffer, bool keepOwnership)
     : BASE(), mOwner(keepOwnership ? ownHandle : ownNone),
       mBufferMapper(GraphicBufferMapper::get()),
       mInitCheck(NO_ERROR), mIndex(-1), mWrappedBuffer(buffer)
+#ifdef VEE4SS_MTK_HWC_ABI
+      , mMva(0), mSize(0)
+#endif
 {
     width  = buffer->width;
     height = buffer->height;
@@ -106,6 +121,9 @@ GraphicBuffer::GraphicBuffer(ANativeWindowBuffer* buffer, bool keepOwnership)
 
 GraphicBuffer::~GraphicBuffer()
 {
+#ifdef VEE4SS_MTK_HWC_ABI
+    if (mMva != 0) unmapBuffer();
+#endif
     if (handle) {
         free_handle();
     }
@@ -213,6 +231,60 @@ status_t GraphicBuffer::unlock()
     return res;
 }
 
+#ifdef VEE4SS_MTK_HWC_ABI
+status_t GraphicBuffer::mapBuffer()
+{
+    void* vaddr = NULL;
+    status_t err = lock(0x102, &vaddr);
+    if (err != NO_ERROR) return err;
+
+    int bpp = (format == 0x100) ? 2 : bytesPerPixel(format);
+    if (bpp <= 0) {
+        unlock();
+        return BAD_VALUE;
+    }
+
+    const uint32_t size = width * height * bpp;
+    if (mMva != 0 || mSize != 0) {
+        err = (mMva != 0 && mSize == size) ? NO_ERROR : BAD_VALUE;
+    } else {
+        mSize = size;
+        GraphicBufferAllocator& allocator(GraphicBufferAllocator::get());
+        err = allocator.map(reinterpret_cast<uint32_t>(vaddr), width, height,
+                size, format, &mMva);
+        if (err != NO_ERROR) {
+            mMva = 0;
+            mSize = 0;
+        }
+    }
+    unlock();
+    return err;
+}
+
+status_t GraphicBuffer::unmapBuffer()
+{
+    void* vaddr = NULL;
+    status_t err = lock(0x102, &vaddr);
+    if (err != NO_ERROR) return err;
+
+    int bpp = (format == 0x100) ? 2 : bytesPerPixel(format);
+    const uint32_t size = bpp > 0 ? width * height * bpp : 0;
+    if (size == 0 || mSize != size || mMva == 0) {
+        unlock();
+        return BAD_VALUE;
+    }
+
+    GraphicBufferAllocator& allocator(GraphicBufferAllocator::get());
+    err = allocator.unmap(reinterpret_cast<uint32_t>(vaddr), size, format, mMva);
+    if (err == NO_ERROR) {
+        mMva = 0;
+        mSize = 0;
+    }
+    unlock();
+    return err;
+}
+#endif
+
 size_t GraphicBuffer::getFlattenedSize() const {
     return (8 + (handle ? handle->numInts : 0))*sizeof(int);
 }
diff --git a/libs/ui/GraphicBufferAllocator.cpp b/libs/ui/GraphicBufferAllocator.cpp
index 7e93a7f76..4d8d7d321 100644
--- a/libs/ui/GraphicBufferAllocator.cpp
+++ b/libs/ui/GraphicBufferAllocator.cpp
@@ -29,6 +29,16 @@
 namespace android {
 // ---------------------------------------------------------------------------
 
+struct mmu_mapper_device_t {
+    hw_device_t common;
+    int (*map)(uint32_t addr, uint32_t size, uint32_t offset,
+            uint32_t format, uint32_t usage, uint32_t* mva);
+    int (*unmap)(uint32_t addr, uint32_t size, uint32_t offset,
+            uint32_t format);
+    int (*query)(uint32_t addr, uint32_t size, uint32_t format,
+            uint32_t* mva);
+};
+
 ANDROID_SINGLETON_STATIC_INSTANCE( GraphicBufferAllocator )
 
 Mutex GraphicBufferAllocator::sLock;
@@ -36,7 +46,7 @@ KeyedVector<buffer_handle_t,
     GraphicBufferAllocator::alloc_rec_t> GraphicBufferAllocator::sAllocList;
 
 GraphicBufferAllocator::GraphicBufferAllocator()
-    : mAllocDev(0)
+    : mAllocDev(0), mMapperDev(0)
 {
     hw_module_t const* module;
     int err = hw_get_module(GRALLOC_HARDWARE_MODULE_ID, &module);
@@ -44,13 +54,65 @@ GraphicBufferAllocator::GraphicBufferAllocator()
     if (err == 0) {
         gralloc_open(module, &mAllocDev);
     }
+    initMapper();
 }
 
 GraphicBufferAllocator::~GraphicBufferAllocator()
 {
+    uninitMapper();
     gralloc_close(mAllocDev);
 }
 
+status_t GraphicBufferAllocator::initMapper()
+{
+    hw_module_t const* module;
+    int err = hw_get_module("mmumapper", &module);
+    if (err != 0) {
+        ALOGE("FATAL: can't find the mmumapper module (%s)", strerror(-err));
+        return err;
+    }
+
+    err = module->methods->open(module, "mmumapper",
+            reinterpret_cast<hw_device_t**>(&mMapperDev));
+    ALOGE_IF(err, "couldn't open mmumapper HAL (%s)", strerror(-err));
+    return err;
+}
+
+void GraphicBufferAllocator::uninitMapper()
+{
+    if (mMapperDev != 0) {
+        mMapperDev->common.close(&mMapperDev->common);
+        mMapperDev = 0;
+    }
+}
+
+status_t GraphicBufferAllocator::map(uint32_t addr, uint32_t size,
+        uint32_t offset, uint32_t format, uint32_t usage, uint32_t* mva)
+{
+    if (mMapperDev == 0 || mMapperDev->map == 0) {
+        return -1;
+    }
+    return mMapperDev->map(addr, size, offset, format, usage, mva);
+}
+
+status_t GraphicBufferAllocator::unmap(uint32_t addr, uint32_t size,
+        uint32_t offset, uint32_t format)
+{
+    if (mMapperDev == 0 || mMapperDev->unmap == 0) {
+        return -1;
+    }
+    return mMapperDev->unmap(addr, size, offset, format);
+}
+
+status_t GraphicBufferAllocator::query(uint32_t addr, uint32_t size,
+        uint32_t format, uint32_t* mva)
+{
+    if (mMapperDev == 0 || mMapperDev->query == 0) {
+        return -1;
+    }
+    return mMapperDev->query(addr, size, format, mva);
+}
+
 void GraphicBufferAllocator::dump(String8& result) const
 {
     Mutex::Autolock _l(sLock);
diff --git a/services/surfaceflinger/Android.mk b/services/surfaceflinger/Android.mk
index a0b298bfd..137ad7e1e 100644
--- a/services/surfaceflinger/Android.mk
+++ b/services/surfaceflinger/Android.mk
@@ -20,6 +20,11 @@ LOCAL_SRC_FILES:= \
 LOCAL_CFLAGS:= -DLOG_TAG=\"SurfaceFlinger\"
 LOCAL_CFLAGS += -DGL_GLEXT_PROTOTYPES -DEGL_EGLEXT_PROTOTYPES
 
+# The stock MT6575 HWC blob uses MediaTek's extended JB layer-list ABI.
+ifeq ($(TARGET_DEVICE),vee4ss)
+    LOCAL_CFLAGS += -DVEE4SS_MTK_HWC_ABI
+endif
+
 ifeq ($(TARGET_BOARD_PLATFORM), omap4)
 	LOCAL_CFLAGS += -DHAS_CONTEXT_PRIORITY
 endif
diff --git a/services/surfaceflinger/DisplayHardware/HWComposer.cpp b/services/surfaceflinger/DisplayHardware/HWComposer.cpp
index ae7c196b3..34b5f80f0 100644
--- a/services/surfaceflinger/DisplayHardware/HWComposer.cpp
+++ b/services/surfaceflinger/DisplayHardware/HWComposer.cpp
@@ -155,7 +155,7 @@ status_t HWComposer::createWorkList(size_t numLayers) {
         if (!mList || mCapacity < numLayers) {
             free(mList);
             size_t size = sizeof(hwc_layer_list) + numLayers*sizeof(hwc_layer_t);
-            mList = (hwc_layer_list_t*)malloc(size);
+            mList = (hwc_layer_list_t*)calloc(1, size);
             mCapacity = numLayers;
         }
         mList->flags = HWC_GEOMETRY_CHANGED;
@@ -206,9 +206,16 @@ size_t HWComposer::getLayerCount(int type) const {
 }
 
 status_t HWComposer::commit() const {
+#ifdef VEE4SS_MTK_HWC_ABI
+    /* MTK's HWC blob only posts the framebuffer when this private bit is set. */
+    if (mList) mList->mtkFlags |= 0x2; // LAYERS_SWAP_REQUIRED
+#endif
     int err = mHwc->set(mHwc, mDpy, mSur, mList);
     if (mList) {
         mList->flags &= ~HWC_GEOMETRY_CHANGED;
+#ifdef VEE4SS_MTK_HWC_ABI
+        mList->mtkFlags &= ~0x6;
+#endif
     }
     return (status_t)err;
 }
