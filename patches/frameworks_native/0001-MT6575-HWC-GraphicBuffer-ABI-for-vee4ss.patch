Subject: [PATCH] MT6575 HWC/GraphicBuffer ABI for vee4ss

LG's MT6575 graphics blobs use MediaTek extensions to the JB HWC and
GraphicBuffer ABI. Under VEE4SS_MTK_HWC_ABI (TARGET_DEVICE=vee4ss only):
GraphicBuffer keeps the stock mMva/mSize members and the mmumapper
map/unmap interface, SurfaceFlinger fills the MTK layer fields
(GraphicBuffer*, alpha, 3x3 transform) and sets private list bit 0x2
before set(). Without that bit the vendor HWC never posts the frame.

---
diff --git a/include/ui/GraphicBuffer.h b/include/ui/GraphicBuffer.h
index 304bcfcac..b799d1362 100644
--- a/include/ui/GraphicBuffer.h
+++ b/include/ui/GraphicBuffer.h
@@ -104,6 +104,11 @@ public:
     status_t lock(uint32_t usage, const Rect& rect, void** vaddr);
     status_t unlock();
 
+#ifdef VEE4SS_MTK_HWC_ABI
+    status_t mapBuffer();
+    status_t unmapBuffer();
+#endif
+
     ANativeWindowBuffer* getNativeBuffer() const;
     
     void setIndex(int index);
@@ -164,6 +169,10 @@ private:
     // If we're wrapping another buffer then this reference will make sure it
     // doesn't get freed.
     sp<ANativeWindowBuffer> mWrappedBuffer;
+#ifdef VEE4SS_MTK_HWC_ABI
+    uint32_t mMva;   // Stock MT6575 ABI: absolute object offset 124.
+    uint32_t mSize;  // Stock MT6575 ABI: absolute object offset 128.
+#endif
 };
 
 }; // namespace android
diff --git a/include/ui/GraphicBufferAllocator.h b/include/ui/GraphicBufferAllocator.h
index c4b5f6395..c28dfbd3c 100644
--- a/include/ui/GraphicBufferAllocator.h
+++ b/include/ui/GraphicBufferAllocator.h
@@ -36,6 +36,7 @@ namespace android {
 // ---------------------------------------------------------------------------
 
 class String8;
+struct mmu_mapper_device_t;
 
 class GraphicBufferAllocator : public Singleton<GraphicBufferAllocator>
 {
@@ -75,6 +76,13 @@ public:
 
     status_t free(buffer_handle_t handle);
 
+    status_t map(uint32_t addr, uint32_t size, uint32_t offset,
+            uint32_t format, uint32_t usage, uint32_t* mva);
+    status_t unmap(uint32_t addr, uint32_t size, uint32_t offset,
+            uint32_t format);
+    status_t query(uint32_t addr, uint32_t size, uint32_t format,
+            uint32_t* mva);
+
     void dump(String8& res) const;
     static void dumpToSystemLog();
 
@@ -94,8 +102,12 @@ private:
     friend class Singleton<GraphicBufferAllocator>;
     GraphicBufferAllocator();
     ~GraphicBufferAllocator();
+
+    status_t initMapper();
+    void uninitMapper();
     
     alloc_device_t  *mAllocDev;
+    mmu_mapper_device_t *mMapperDev;
 };
 
