 {
     width  =
     height =
@@ -82,6 +91,9 @@ GraphicBuffer::GraphicBuffer(uint32_t w, uint32_t h,
     : BASE(), mOwner(keepOwnership ? ownHandle : ownNone),
       mBufferMapper(GraphicBufferMapper::get()),
