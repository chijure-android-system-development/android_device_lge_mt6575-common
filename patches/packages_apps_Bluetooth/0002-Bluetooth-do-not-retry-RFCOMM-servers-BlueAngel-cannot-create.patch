Subject: [PATCH] Bluetooth: do not retry RFCOMM servers BlueAngel cannot create

MediaTek's BlueAngel stack has no RFCOMM server sockets for apps
(IOException "Function not implemented"). PBAP, MAP and OPP retried 10
times 3 s apart, PBAP and MAP on the main thread, so com.android.bluetooth
hit an ANR when Bluetooth turned on. Give up on that error.
---
diff --git a/src/com/android/bluetooth/map/BluetoothMasService.java b/src/com/android/bluetooth/map/BluetoothMasService.java
index 788bf294..5c8ca522 100644
--- a/src/com/android/bluetooth/map/BluetoothMasService.java
+++ b/src/com/android/bluetooth/map/BluetoothMasService.java
@@ -675,6 +675,11 @@ public class BluetoothMasService extends Service {
                 } catch (IOException e) {
                     Log.e(TAG, "Error create RfcommServerSocket " + e.toString());
                     initSocketOK = false;
+                    // MediaTek's BlueAngel stack has no RFCOMM server sockets
+                    // for apps; retrying blocks the main thread for 30 s.
+                    if (String.valueOf(e.getMessage()).contains("Function not implemented")) {
+                        break;
+                    }
                 }
 
                 if (!initSocketOK) {
diff --git a/src/com/android/bluetooth/opp/BluetoothOppRfcommListener.java b/src/com/android/bluetooth/opp/BluetoothOppRfcommListener.java
index 5df4f978..f3dc1785 100644
--- a/src/com/android/bluetooth/opp/BluetoothOppRfcommListener.java
+++ b/src/com/android/bluetooth/opp/BluetoothOppRfcommListener.java
@@ -128,6 +128,11 @@ public class BluetoothOppRfcommListener {
                             } catch (IOException e1) {
                                 Log.e(TAG, "Error create RfcommServerSocket " + e1);
                                 serverOK = false;
+                                // MediaTek's BlueAngel stack has no RFCOMM
+                                // server sockets for apps; do not retry.
+                                if (String.valueOf(e1.getMessage()).contains("Function not implemented")) {
+                                    break;
+                                }
                             }
                             if (!serverOK) {
                                 synchronized (this) {
diff --git a/src/com/android/bluetooth/pbap/BluetoothPbapService.java b/src/com/android/bluetooth/pbap/BluetoothPbapService.java
index 0c12c14b..2592c1d0 100644
--- a/src/com/android/bluetooth/pbap/BluetoothPbapService.java
+++ b/src/com/android/bluetooth/pbap/BluetoothPbapService.java
@@ -344,6 +344,11 @@ public class BluetoothPbapService extends Service {
             } catch (IOException e) {
                 Log.e(TAG, "Error create RfcommServerSocket " + e.toString());
                 initSocketOK = false;
+                // MediaTek's BlueAngel stack has no RFCOMM server sockets for
+                // apps; retrying blocks the main thread for 30 s (ANR).
+                if (String.valueOf(e.getMessage()).contains("Function not implemented")) {
+                    break;
+                }
             }
             if (!initSocketOK) {
                 synchronized (this) {
