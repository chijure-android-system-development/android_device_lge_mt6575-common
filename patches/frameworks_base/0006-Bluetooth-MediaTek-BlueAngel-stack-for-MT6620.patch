+        if (mService != null) {
+            try {
+                return mService.disconnect(device);
+            } catch (RemoteException e) {
+                Log.e(TAG, "Exception occurred in disconnect(): " + e);
+            }
+	}
+        else {
+            Log.e (TAG, "mService is null");
+            if(DBG) { Log.d(TAG,Log.getStackTraceString(new Throwable())); }
+	}
+	return false;
+    }
