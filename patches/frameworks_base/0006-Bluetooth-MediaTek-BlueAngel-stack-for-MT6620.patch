+void btmtk_host_cache_write(native_data_t *nat)
+{
+    int fd, len;
+    int size = sizeof(btmtk_host_cache_struct);
+
+    LOGI("[GAP] btmtk_host_cache_write");
+    if ((fd = open(BTMTK_HOST_CACHE_PATH, O_WRONLY | O_CREAT, 0666)) < 0)
+    {
+        LOGE("[GAP] btmtk_host_cache_write open error %d: %s", errno, strerror(errno));
+        return;
+    }
+	len = write(fd, &nat->host_cache, size);
+	if (len < 0 || len != size) 
+    {
+        LOGE("[GAP] btmtk_host_cache_write %d byte error %d: %s", len, errno, strerror(errno));
+	}
+    close(fd);
+}
