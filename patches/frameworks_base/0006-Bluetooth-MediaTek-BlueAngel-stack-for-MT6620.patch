+btmtk_hdp_fd_struct *btmtk_hdp_util_find_hdp_fd(native_data_t *nat, bt_addr_struct *addr, unsigned short mdlid)
+{
+    btmtk_hdp_fd_struct *ptr = nat->hdp_fds;
+    LOGI("[HDP] btmtk_util_find_hdp_fd search 0x%lX:0x%X:0x%X: mdl id=0x%X", addr->lap, addr->uap, addr->nap, mdlid);
+    while (ptr)
+    {
+        LOGI("[HDP] btmtk_util_find_hdp_fd found 0x%lX:0x%X:0x%X", ptr->addr.lap, ptr->addr.uap, ptr->addr.nap);
+        if (btmtk_util_equal_bdaddr(&ptr->addr, addr) && 
+            ptr->mdl_id == mdlid)
+        {
+            return ptr;
+        }
+        ptr = ptr->next;
+    }
+    return NULL;
+}
