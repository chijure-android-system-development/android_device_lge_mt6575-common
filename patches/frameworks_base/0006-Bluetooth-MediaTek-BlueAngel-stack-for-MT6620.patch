+/*****************************************************************************
+ * FUNCTION
+ *  btmtk_host_cache_init
+ * DESCRIPTION
+ *  Read all paired device cache data from file
+ * PARAMETERS
+ *  void
+ * RETURNS
+ *  void
+ *****************************************************************************/
+void btmtk_host_cache_init(native_data_t *nat)
+{
+    int fd;
+    struct stat sts;
+    int size = sizeof(btmtk_host_cache_struct);
+    
+    LOGI("[GAP] btmtk_host_cache_init");
+    memset(&nat->host_cache, 0x0, size);
+    if (stat(BTMTK_HOST_CACHE_PATH, &sts) == -1 || 
+        sts.st_size != size ||
+        (fd = open(BTMTK_HOST_CACHE_PATH, O_RDONLY)) < 0)
+    {
+        unlink(BTMTK_HOST_CACHE_PATH);
+        char op[PROPERTY_VALUE_MAX];
+        property_get("ro.operator.optr", op, "");
+        if(!strcmp(op,"OP01")){	//CMCC Athens15 project
+          strncpy(nat->host_cache.name, "MTK Athens15", BTBM_ADP_MAX_NAME_LEN);
+        } else {
+          btmtk_set_default_local_name(&nat->host_cache);
+        }
+        //nat->host_cache.scan_mode = BTBM_ADP_P_ON_I_ON;
+        btmtk_host_cache_write(nat);
+        LOGE("[GAP] btmtk_host_cache_init open error %d: %s", errno, strerror(errno));
+    }
+    else
+    {
+        int read_byte = read(fd, &nat->host_cache, size), i;
+        if (read_byte < 0) 
+        {
+            LOGE("[GAP] btmtk_host_cache_init read error %d: %s", errno, strerror(errno));
+        } 
+        else if (read_byte != size) 
+        {
+            LOGE("[GAP] btmtk_host_cache_init read error(%d bytes read) %d: %s", read_byte, errno, strerror(errno));
+        }
+        close(fd);
+
+        if (!strncmp(nat->host_cache.name, BTMTK_ANDROID_DEFAULT_LOCAL_NAME, BTBM_ADP_MAX_NAME_LEN)) {
+            btmtk_set_default_local_name(&nat->host_cache);
+            btmtk_host_cache_write(nat);
+        }
+    }
+}
