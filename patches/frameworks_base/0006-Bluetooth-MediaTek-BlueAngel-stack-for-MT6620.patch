+    }
+    else
+    {
+        int read_byte = read(fd, nat->paired_dev_cache, size), i;
+        if (read_byte < 0) 
+        {
+            LOGE("[GAP] btmtk_paired_dev_cache_init read error %d: %s", errno, strerror(errno));
+        } 
+        else if (read_byte != size) 
+        {
+            LOGE("[GAP] btmtk_paired_dev_cache_init read error(%d bytes read) %d: %s", read_byte, errno, strerror(errno));
+        }
+        close(fd);
+
+        for (i = 0; i < BTBM_ADP_MAX_PAIRED_LIST_NO; i++)
