+//SH : add for unaligned ntos
+unsigned short pntohs(char *arr)
+{
+    LOGI("pntohs(0x%02X%02X) : addr=%p", arr[0], arr[1], arr);
+    if( (((U32)arr) & 0x1) )
+    {
+        unsigned short tmp;
+        LOGI("pntohs : use tmp");
+        memcpy(&tmp, arr, sizeof(unsigned short));
+        return ntohs(tmp);
+    }
+    else
+    {
+        return ntohs(*(unsigned short*)arr);
+    }
+}
+
