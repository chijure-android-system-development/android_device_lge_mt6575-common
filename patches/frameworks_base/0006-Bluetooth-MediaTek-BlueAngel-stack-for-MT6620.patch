+{
+    LOGI("pntohl(0x%02X%02X%02X%02X) : addr=%p", arr[0], arr[1], arr[2], arr[3], arr);
+    if( (((U32)arr) & 0x3) )
+    {
+        unsigned long tmp;
+        LOGI("pntohl : use tmp");
+        memcpy(&tmp, arr, sizeof(unsigned long));
+        return ntohl(tmp);
+    }
+    else
+    {
+        return ntohl(*(unsigned long*)arr);
+    }
+}
