+			Log.e(TAG, "Could not bind to Bluetooth Simap Service");
+		}
+		
+	}
+
+	public BluetoothSimap(Context context)
+	{
+		mContext = context;
+        mServiceListener = null;
+
+		if (!context.bindService(new Intent(IBluetoothSimap.class.getName()), mConnection, 0)) {
+			Log.e(TAG, "Could not bind to Bluetooth Simap Service");
+		}
