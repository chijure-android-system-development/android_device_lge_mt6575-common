+            Log.e(TAG, "Could not bind to Bluetooth BIPI Service");
+        }
+    }
+
+    public synchronized void close(){
+        try {
+            if (mService != null) {
+                mService = null;
+            }
+
+            if (mConnection != null) {
+                mContext.unbindService(mConnection);
+                mConnection = null;
+            }
+        } catch (Exception e) {
+            Log.e(TAG, "Exception occurred in close(): " + e);
+        }
+    }
+
