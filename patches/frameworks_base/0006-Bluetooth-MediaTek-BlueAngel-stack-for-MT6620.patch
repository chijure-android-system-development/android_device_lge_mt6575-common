+static void btmtk_set_default_local_name(btmtk_host_cache_struct *host_cache)
+{
+    char model[PROPERTY_VALUE_MAX];
+
+    property_get("ro.product.model", model, BTMTK_ANDROID_DEFAULT_LOCAL_NAME);
+    if (!model[0]) {
+        strncpy(model, BTMTK_ANDROID_DEFAULT_LOCAL_NAME, sizeof(model));
+        model[sizeof(model) - 1] = '\0';
+    }
+
+    memset(host_cache->name, 0x0, BTBM_ADP_MAX_NAME_LEN);
+    strncpy(host_cache->name, model, BTBM_ADP_MAX_NAME_LEN - 1);
+}
