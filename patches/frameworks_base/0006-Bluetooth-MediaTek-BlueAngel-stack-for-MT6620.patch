@@ -0,0 +1,23 @@
+package com.mediatek.featureoption;
+
+/**
+ * Minimal MTK feature switches required by the BlueAngel Bluetooth framework.
+ */
+public final class FeatureOption {
+    // false on this non-MTK (Broadcom) device: routes BluetoothSocket through
+    // the real, already-compiled BlueZ/kernel-socket JNI implementation in
+    // android_bluetooth_BluetoothSocket.cpp (unconditionally registered,
+    // linked whenever BOARD_HAVE_BLUETOOTH_MTK isn't set -- see
+    // frameworks/base/core/jni/Android.mk) instead of the MTK AIDL path,
+    // which depends on IBluetoothSocket/BluetoothSocketService -- a service
+    // that never gets registered here since its native side is MTK-only
+    // (see SystemServer.java's try/catch around BluetoothSocketService).
+    // With MTK_BT_PROFILE_SPP=true, every BluetoothSocket call failed with
+    // "[JSR82] BluetoothSocket: IBluetoothSocket is null", which made
+    // BluetoothOppRfcommListener/BluetoothPbapService retry and give up in
+    // a loop every time com.android.bluetooth restarted.
+    public static final boolean MTK_BT_PROFILE_SPP = false;
+
+    private FeatureOption() {
+    }
+}
