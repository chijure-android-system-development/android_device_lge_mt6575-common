+	/* Client States */
+	public final static int BT_FTPC_STATE_IDLE				= 200;
+	public final static int BT_FTPC_STATE_ACTIVE			= 201;
+	public final static int BT_FTPC_STATE_AUTHORIZING		= 202;
+	public final static int BT_FTPC_STATE_CONNECTED			= 203;
