Subject: [PATCH] UsbDeviceManager: skip the RNDIS MAC when f_rndis has no ethaddr node

MT6575 kernels have no RNDIS ethaddr file; writing it only logged an
error on every USB change.

---
diff --git a/services/java/com/android/server/usb/UsbDeviceManager.java b/services/java/com/android/server/usb/UsbDeviceManager.java
index 7fd52d955e4..95f6135a6b2 100644
--- a/services/java/com/android/server/usb/UsbDeviceManager.java
+++ b/services/java/com/android/server/usb/UsbDeviceManager.java
@@ -250,10 +250,11 @@ public class UsbDeviceManager {
         }
         String addrString = String.format("%02X:%02X:%02X:%02X:%02X:%02X",
             address[0], address[1], address[2], address[3], address[4], address[5]);
+        if (!new java.io.File(RNDIS_ETH_ADDR_PATH).exists()) return;
         try {
             FileUtils.stringToFile(RNDIS_ETH_ADDR_PATH, addrString);
         } catch (IOException e) {
-           Slog.e(TAG, "failed to write to " + RNDIS_ETH_ADDR_PATH);
+            Slog.d(TAG, "failed to write to " + RNDIS_ETH_ADDR_PATH);
         }
     }
 
