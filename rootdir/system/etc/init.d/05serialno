#!/system/bin/sh

# The LG bootloader passes no androidboot.serialno; LG's init reads the
# serial from /sys/sys_info/serial_number instead, CM's does not, so the
# USB gadget kept the kernel's 0123456789ABCDEF and every phone showed up
# in adb with the same serial. Set the stock one (codename plus eMMC serial
# if the kernel has none). ro.serialno cannot follow: init already set it,
# empty.

serial=$(cat /sys/sys_info/serial_number 2>/dev/null)
if [ -z "$serial" ]; then
    emmc=$(cat /sys/block/mmcblk0/device/serial 2>/dev/null)
    [ -n "$emmc" ] || exit 0
    serial="$(getprop ro.product.device)-${emmc#0x}"
fi

usb=/sys/class/android_usb/android0
echo "$serial" > $usb/iSerial
# init already enumerated USB with the old serial; enumerate again, and
# restart adbd so the host does not keep the old session and show the
# phone offline.
if [ "$(cat $usb/enable)" = 1 ]; then
    echo 0 > $usb/enable
    echo 1 > $usb/enable
    if [ "$(getprop init.svc.adbd)" = running ]; then
        stop adbd
        start adbd
    fi
fi
