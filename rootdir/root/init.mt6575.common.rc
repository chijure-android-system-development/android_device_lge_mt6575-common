import /init.mt6575.usb.rc

on early-init
    write /dev/kmsg "CMBOOT: early-init\n"
    mount debugfs debugfs /sys/kernel/debug

on init
    write /dev/kmsg "CMBOOT: init\n"
    # Missing MTK symbols (xlog) for the vendor blobs, see libmtk_symbols
    export LD_PRELOAD libmtk_symbols.so
    # Almacenamiento interno via sdcard FUSE daemon — monta en /storage/sdcard0
    mkdir /storage 0755 root root
    mkdir /storage/sdcard0 0775 system system

    export EXTERNAL_STORAGE /storage/sdcard0

    # MicroSD externo
    mkdir /storage/sdcard1 0775 system system
    export SECONDARY_STORAGE /storage/sdcard1

    symlink /storage/sdcard0 /sdcard
    symlink /storage/sdcard0 /mnt/sdcard
    symlink /storage/sdcard1 /external_sd
    symlink /storage/sdcard1 /mnt/external_sd

on fs
    write /dev/kmsg "CMBOOT: fs - before mount_all\n"
    mount_all /fstab.mt6575
    write /dev/kmsg "CMBOOT: fs - after mount_all\n"
    setprop ro.crypto.fuse_sdcard true

on post-fs-data
    # NVRAM dirs — must exist before nvram_daemon runs.
    # Created here (not post-fs) because /data is not mounted in post-fs.
    mkdir /data/nvram 0771 root system
    mkdir /data/nvram/md 0770 root system

    # MTP / USB media
    mkdir /data/media 0770 media_rw media_rw

    # Wifi
    mkdir /data/misc/wifi 0770 wifi wifi
    mkdir /data/misc/wifi/sockets 0770 wifi wifi
    mkdir /data/misc/wpa_supplicant 0770 wifi wifi
    mkdir /data/misc/p2p_supplicant 0770 wifi wifi
    mkdir /data/misc/dhcp 0770 dhcp dhcp
    chown wifi wifi /data/misc/wifi
    chown wifi wifi /data/misc/wifi/sockets
    chown wifi wifi /data/misc/wpa_supplicant
    chown wifi wifi /data/misc/p2p_supplicant
    chown dhcp dhcp /data/misc/dhcp
    chmod 0660 /data/misc/wifi/wpa_supplicant.conf
    chmod 0660 /data/misc/wifi/p2p_supplicant.conf

    # BT
    mkdir /data/misc/bluetooth 0770 bluetooth bluetooth

    # AGPS
    mkdir /data/agps_supl 0770 gps system

    setprop vold.post_fs_data_done 1

on boot
    write /dev/kmsg "CMBOOT: boot - loading modules\n"
    # Kernel modules — cargar antes de que arranquen los servicios
    insmod /system/lib/modules/pvrsrvkm.ko
    chmod 0666 /dev/pvrsrvkm
    insmod /system/lib/modules/mtklfb.ko
    insmod /system/lib/modules/devinfo.ko
    insmod /system/lib/modules/mtk_drvb.ko
    insmod /system/lib/modules/ccci_plat.ko
    insmod /system/lib/modules/ccci.ko
    insmod /system/lib/modules/ccmni.ko
    insmod /system/lib/modules/m4u.ko
    insmod /system/lib/modules/vcodec_kernel_driver.ko
    insmod /system/lib/modules/sec.ko
    # Combo chip stack (MT6620): hif_sdio -> wmt -> uart/gps/bt/wifi transports
    # wlan.ko is loaded by the WiFi HAL in user-space when WiFi is enabled
    insmod /system/lib/modules/mtk_hif_sdio.ko
    insmod /system/lib/modules/mtk_stp_wmt.ko
    insmod /system/lib/modules/mtk_stp_uart.ko
    insmod /system/lib/modules/mtk_stp_gps.ko
    insmod /system/lib/modules/mtk_stp_bt.ko
    insmod /system/lib/modules/mtk_fm_drv.ko
    insmod /system/lib/modules/mtk_fm_priv.ko
    insmod /system/lib/modules/mtk_wmt_wifi.ko
    insmod /system/lib/modules/wlan.ko

    # Camera / MHAL / MDP nodes. /dev/M4U_device is created by
    # /system/etc/init.d/10mtk-nodes because this Android init has no mknod.
    chown system camera /dev/kd_camera_hw
    chown system camera /dev/FM50AF
    chown system camera /dev/kd_camera_flashlight
    chown system camera /dev/camera-resmgr
    chown system camera /dev/camera-sysram
    chown system camera /dev/camera-isp
    chown system camera /dev/camera-eis
    chown system camera /dev/camera-fdvt
    chown system camera /dev/mt-mdp
    chown system camera /dev/mtk_jpeg
    chown system camera /dev/M4U_device
    chown root media /proc/clkmgr/mipi_test
    chown system media /sys/bus/platform/drivers/mem_bw_ctrl/concurrency_scenario
    chmod 0660 /dev/kd_camera_hw
    chmod 0660 /dev/FM50AF
    chmod 0660 /dev/kd_camera_flashlight
    chmod 0660 /dev/camera-resmgr
    chmod 0660 /dev/camera-sysram
    chmod 0660 /dev/camera-isp
    chmod 0660 /dev/camera-eis
    chmod 0660 /dev/camera-fdvt
    chmod 0660 /dev/mt-mdp
    chmod 0444 /dev/mtk_jpeg
    chmod 0660 /dev/M4U_device

    # CCCI modem device nodes are created by /system/etc/init.d/10mtk-nodes.
    chmod 0660 /dev/ccci_fs
    chmod 0660 /dev/ccci_rpc
    chmod 0660 /dev/ccci_sys_rx
    chmod 0660 /dev/ccci_sys_tx
    chmod 0660 /dev/ccci_pcm_rx
    chmod 0660 /dev/ccci_pcm_tx
    chmod 0660 /dev/ccci_ipc_1220_0
    chmod 0660 /dev/ccci_uem_rx
    chmod 0660 /dev/ccci_uem_tx
    chmod 0660 /dev/ccci_md_log_rx
    chmod 0660 /dev/ccci_md_log_tx
    chmod 0660 /dev/ttyC0
    chmod 0660 /dev/ttyC1
    chmod 0660 /dev/ttyC2
    chown radio radio /dev/ccci_fs
    chown radio radio /dev/ccci_rpc
    chown radio radio /dev/ccci_sys_rx
    chown radio radio /dev/ccci_sys_tx
    chown radio radio /dev/ccci_pcm_rx
    chown radio radio /dev/ccci_pcm_tx
    chown radio radio /dev/ccci_ipc_1220_0
    chown radio radio /dev/ccci_uem_rx
    chown radio radio /dev/ccci_uem_tx
    chown radio radio /dev/ccci_md_log_rx
    chown radio radio /dev/ccci_md_log_tx
    chown radio radio /dev/ttyC0
    chown radio radio /dev/ttyC1
    chown radio radio /dev/ttyC2
    chown radio radio /sys/class/BOOT/BOOT/boot/md
    mkdir /dev/radio 0770 radio radio

    write /dev/kmsg "CMBOOT: boot - modules done, starting services\n"

    # CPU governor
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor interactive

    # Backlight
    chown system system /sys/class/leds/lcd-backlight/brightness
    chmod 0660 /sys/class/leds/lcd-backlight/brightness

    # Button backlight — desactivar el blink que el kernel MTK activa por defecto
    write /sys/class/leds/button-backlight/trigger none
    write /sys/class/leds/button-backlight/brightness 0

    # Red LP5521 (LEDs de notificación)
    chown system system /sys/class/leds/R/brightness
    chown system system /sys/class/leds/G/brightness
    chown system system /sys/class/leds/B/brightness
    chown system system /sys/bus/i2c/drivers/lp5521/1-0032/led_blink
    chown system system /sys/bus/i2c/drivers/lp5521/1-0032/led_pattern
    chmod 0660 /sys/class/leds/R/brightness
    chmod 0660 /sys/class/leds/G/brightness
    chmod 0660 /sys/class/leds/B/brightness
    chmod 0660 /sys/bus/i2c/drivers/lp5521/1-0032/led_blink
    chmod 0660 /sys/bus/i2c/drivers/lp5521/1-0032/led_pattern

    # MTK ALPS sensor hub — sensors.mt6575.so solo usa /dev/hwmsensor
    chown system system /dev/hwmsensor
    chown system system /dev/gsensor
    chown system system /dev/msensor
    chown system system /dev/als_ps
    chown system system /sys/bus/platform/drivers/gsensor/cali
    chown system system /sys/bus/platform/drivers/gsensor/fast_calibration_x
    chown system system /sys/bus/platform/drivers/gsensor/fast_calibration_y
    chown system system /sys/bus/platform/drivers/gsensor/fast_calibration_z
    chown system system /sys/bus/platform/drivers/gsensor/eeprom_writing
    chown system system /sys/bus/platform/drivers/gsensor/softreset
    chown system system /sys/bus/platform/drivers/gsensor/bandwidth
    chown system system /sys/bus/platform/drivers/gsensor/cpsbandwidth
    chown system system /sys/bus/platform/drivers/gsensor/cpsdata
    chown system system /sys/bus/platform/drivers/gsensor/cpsopmode
    chown system system /sys/bus/platform/drivers/gsensor/cpsrange
    chown system system /sys/bus/platform/drivers/msensor/daemon
    chown system system /sys/bus/platform/drivers/msensor/daemon2
    chown system system /sys/bus/platform/drivers/msensor/cpsdata
    chown system system /sys/bus/platform/drivers/msensor/cpsopmode
    chown system system /sys/bus/platform/drivers/msensor/cpsreptxy
    chown system system /sys/bus/platform/drivers/msensor/cpsreptz
    chown system system /sys/bus/platform/drivers/als_ps/cali
    chmod 0660 /dev/hwmsensor
    chmod 0660 /dev/gsensor
    chmod 0660 /dev/msensor
    chmod 0660 /dev/als_ps
    chmod 0660 /sys/bus/platform/drivers/msensor/daemon
    chmod 0660 /sys/bus/platform/drivers/msensor/daemon2
    chmod 0660 /sys/bus/platform/drivers/msensor/cpsopmode

    # Permisos de dispositivos MTK
    chmod 0660 /dev/nvram
    chown root system /dev/nvram
    # lgpserver reads IMEI/SIM-lock data from /dev/misc2 (LGE MISC2 partition).
    chmod 0660 /dev/misc2
    chown root system /dev/misc2

    # STP nodes for the MT6620 combo chip. The stock ramdisk creates these
    # explicitly before WiFi/BT/GPS userspace touches WMT.
    chmod 0660 /dev/stpwmt
    chmod 0660 /dev/stpgps
    chmod 0660 /dev/stpbt
    chmod 0660 /dev/wmtWifi
    chown system system /dev/stpwmt
    chown gps gps /dev/stpgps
    chown bluetooth radio /dev/stpbt
    chown system system /dev/wmtWifi

    # libmtk_drvb.so requires /dev/devmap for DRM/integrity checks.
    # The node is created by /system/etc/init.d/10mtk-nodes.
    chmod 0666 /dev/devmap

    # libmtk_devinfo.so reads /dev/devinfo for WiFi MAC and BT address.
    # Node is created when devinfo.ko is insmod'd above.
    chmod 0660 /dev/devinfo
    chown system system /dev/devinfo

    # mtk-ril.so (Gemini) requires the AT channel device as its first argument.
    # PRODUCT_PROPERTY_OVERRIDES can't handle spaces in values, so set here.
    setprop rild.libargs "-d /dev/radio/pttycmd1"

    # Bluetooth
    chmod 0660 /dev/ttyMT2
    chown system system /dev/ttyMT2

    # AGPS
    chmod 0750 /system/bin/mtk_agpsd
    chown gps system /system/bin/mtk_agpsd
    chown gps system /data/agps_supl

    # Vibrador
    chown system system /sys/class/timed_output/vibrator/enable

    # GPU init — before class_start so SurfaceFlinger gets a ready GPU
    exec /system/vendor/bin/pvrsrvctl --start

    # Clase de inicio para servicios del sistema
    class_start default

service ccci_rpcd /system/bin/ccci_rpcd
    class core
    user root
    group radio system

service ccci_fsd /system/bin/ccci_fsd
    class core
    user root
    group radio system

service ccci_mdinit /system/bin/ccci_mdinit
    class core
    user root
    group radio system
    oneshot

service gsm0710muxd /system/bin/gsm0710muxd -s /dev/ttyC0 -f 512 -n 8 -m basic
    class core
    user root
    group radio system
    disabled

service nvram_daemon /system/bin/nvram_daemon
    class main
    user root
    group system
    oneshot

service nvram_agent_binder /system/bin/nvram_agent_binder
    class main
    user root
    group system
    oneshot
    disabled

on property:init.svc.lgpserver=running
    start nvram_agent_binder

service hald /system/bin/hald
    class main
    socket hald stream 660 root system
    user system
    group system radio mount wifi inet net_admin

# GPS daemon, started on demand by gps.default.so (ctl.start mnld); it
# spawns /system/xbin/libmnlp, the MTK navigation library process.
service mnld /system/xbin/mnld
    user system
    group system nvram gps inet
    socket mnld stream 660 system system
    disabled

# GPS power/state nodes, written by mnld. They only appear once the MT6620
# is up, after "on boot", so they are handed to gps here.
on property:sys.boot_completed=1
    # Like LG's EmotionalLedService: the bootloader's power-on pattern on
    # the home key LED runs until boot completes; the lights HAL takes
    # over from here.
    write /sys/bus/i2c/drivers/lp5521/1-0032/led_pattern 0
    chown gps gps /sys/class/gpsdrv/gps/pwrctl
    chown gps gps /sys/class/gpsdrv/gps/suspend
    chown gps gps /sys/class/gpsdrv/gps/state
    chown gps gps /sys/class/gpsdrv/gps/pwrsave
    chown gps gps /sys/class/gpsdrv/gps/status

service agpsd /system/bin/mtk_agpsd
    class main
    socket agpsd stream 660 system system
    user gps
    group system ccci gps inet sdcard_rw

service insmod /system/bin/logwrapper insmod
    disabled
    oneshot

service rmmod /system/bin/logwrapper rmmod
    disabled
    oneshot

service 6620_launcher /system/bin/6620_launcher -m 1 -b 4000000 -p /system/etc/firmware/ -d /dev/ttyMT2
    class core
    user system
    group system

service stp_dump /system/bin/stp_dump3
    class main
    user system
    group system net_admin

# sdcard daemon — emula FAT en /data/media via FUSE, monta en /storage/sdcard0
service sdcard /system/bin/sdcard /data/media 1023 1023
    class late_start

service p2p_supplicant /system/bin/logwrapper /system/bin/wpa_supplicant \
    -iwlan0 -Dnl80211 -c/data/misc/wifi/wpa_supplicant.conf -N \
    -ip2p0 -Dnl80211 -c/data/misc/wifi/p2p_supplicant.conf -e/data/misc/wifi/entropy.bin -puse_p2p_group_interface=1 -ddd
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot

service msensord /system/bin/msensord
    class main
    user system
    group system
    disabled
    oneshot

service wpa_supplicant /system/bin/logwrapper /system/bin/wpa_supplicant \
    -iwlan0 -Dnl80211 -c/data/misc/wifi/wpa_supplicant.conf -e/data/misc/wifi/entropy.bin -ddd
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot

service ap_daemon /system/bin/logwrapper /system/bin/wpa_supplicant \
    -iap0 -Dnl80211 -c/data/misc/wifi/p2p_supplicant.conf -e/data/misc/wifi/entropy.bin -puse_p2p_group_interface=1 -ddd
    class main
    disabled
    oneshot

service dhcpcd_wlan0 /system/bin/dhcpcd -A -BK -dd
    class main
    disabled
    oneshot

service dhcpcd_p2p /system/bin/dhcpcd -ABK
    class main
    disabled
    oneshot

service iprenew_wlan0 /system/bin/dhcpcd -nK
    class main
    disabled
    oneshot

# Shutdown and reboot show LG's pattern 6, as EmotionalLedService does on
# ACTION_SHUTDOWN (the lights HAL stops writing once this is set).
on property:sys.shutdown.requested=*
    write /sys/bus/i2c/drivers/lp5521/1-0032/led_pattern 6
